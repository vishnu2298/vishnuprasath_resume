PORT=4000
JWT_SECRET=change-me-in-production
PUBLIC_URL=https://api.example.com          # used for tracked affiliate links and invite pages
INSIGHTS_URL=http://127.0.0.1:5000

# --- Firebase (phone OTP, Google sign-in, push) ---
FIREBASE_PROJECT_ID=your-firebase-project-id         # enough to verify sign-in tokens
FIREBASE_SERVICE_ACCOUNT_JSON=                       # one-line service-account JSON; needed to SEND push
FIREBASE_DEV_MODE=0                                  # 1 = demo OTP code 123456, no Firebase. NEVER in production.

# --- Affiliate products (SearchAPI Google Shopping) ---
SEARCHAPI_KEY=
SHOPPING_COUNTRY=in
PRODUCT_CACHE_HOURS=12

# --- Affiliate links and tracking ---
AMAZON_TAG=yourtag-21
FLIPKART_AFFID=
AFFILIATE_NETWORKS=[]                                # e.g. [{"match":"myntra.com","template":"https://wrap.example/r?u={url}&s={click}"}]
AFFILIATE_POSTBACK_SECRET=long-random-string         # protects /affiliate/postback, /affiliate/report, /admin/revenue

# --- Invites ---
INVITE_BASE_URL=https://connectly.app
ANDROID_STORE_URL=
IOS_STORE_URL=
